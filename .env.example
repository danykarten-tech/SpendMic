# SpendMic Device Protection Environment Variables
# NOTE: Do NOT commit real secrets to version control. Placeholders only.

# Cryptographic secret for signing HMAC-SHA256 offline authorization tokens.
# Generate a unique random value for every environment; required in production.
LICENSE_SECRET_KEY=replace-with-a-long-random-secret

# Generate an Ed25519 key pair for production. Keep this private key only in
# Vercel. Put the matching base64-encoded SPKI public key in VITE_LICENSE_PUBLIC_KEY.
LICENSE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nreplace-with-your-ed25519-private-key\\n-----END PRIVATE KEY-----"
VITE_LICENSE_PUBLIC_KEY=replace-with-base64-encoded-ed25519-spki-public-key

# Payhip's per-product server secret and the product link/code. These are server
# variables only: never prefix them with VITE_ and never commit real values.
PAYHIP_PRODUCT_SECRET_KEY=replace-with-payhip-product-secret
PAYHIP_PRODUCT_LINK=replace-with-payhip-product-link

# Supabase service-role access is only used by Vercel API routes for licensing
# records. The SQL migration in supabase/migrations creates licensing-only tables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Optional: your private owner activation key. It is compared on the server and
# is never included in the frontend bundle. Store it in your password manager.
SPENDMIC_OWNER_LICENSE_KEY=SPM-OWNR-7H2K-9M4P

# Application environment (development | production)
NODE_ENV=development

# Local-only manual testing. Never add this to Vercel or a production environment.
SPENDMIC_ALLOW_LOCAL_TEST_LICENSES=false
